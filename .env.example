PORT=3000
MONGODB_URI=
MONGODB_DB=impresa_semplice
NODE_ENV=production
TRUST_PROXY=true
COOKIE_SECURE=true
APP_TIME_ZONE=Europe/Rome

# Accesso amministratore
PIN_SCRYPT_ADMIN=
PIN_HASH_ADMIN=
AUTH_SESSION_MINUTES=60
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_MINUTES=5
AUTH_LOCK_MINUTES=5

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=60000

# Google Drive fiscale
DRIVE_FISCALE_ROOT_FOLDER_ID=
DRIVE_MAX_FILE_BYTES=26214400
GOOGLE_HTTP_TIMEOUT_MS=30000
GOOGLE_HTTP_MAX_RETRIES=3
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# PEC / email via IMAP
PEC_IMAP_HOST=
PEC_IMAP_PORT=993
PEC_IMAP_SECURE=true
PEC_IMAP_USER=
PEC_IMAP_PASSWORD=
PEC_IMAP_MAILBOX=INBOX
PEC_IMAP_MAX_MESSAGES=200
PEC_IMAP_OVERLAP_UIDS=50
PEC_IMAP_MAX_MESSAGE_BYTES=52428800
PEC_IMAP_MAX_ATTACHMENT_BYTES=26214400
PEC_IMAP_SOCKET_TIMEOUT_MS=120000
PEC_IMAP_GREETING_TIMEOUT_MS=30000
