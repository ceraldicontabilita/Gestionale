PORT=3000
MONGODB_URI=
MONGODB_DB=impresa_semplice

# Scheduler documentale
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=60000

# Google Drive fiscale: usare ID cartella o URL completo.
DRIVE_FISCALE_ROOT_FOLDER_ID=

# Autenticazione Google: usare un access token temporaneo OPPURE OAuth refresh.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# PEC / email via IMAP. Se incompleto, il relativo job resta disattivato.
PEC_IMAP_HOST=
PEC_IMAP_PORT=993
PEC_IMAP_SECURE=true
PEC_IMAP_USER=
PEC_IMAP_PASSWORD=
PEC_IMAP_MAILBOX=INBOX
PEC_IMAP_MAX_MESSAGES=200
PEC_IMAP_OVERLAP_UIDS=50
